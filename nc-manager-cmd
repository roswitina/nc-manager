 app_update_all) take_lock; runocc app:update --all ;;

 backup)      take_lock; do_backup 0 manuell ;;
 backup_full) take_lock; do_backup 1 'manuell (mit Benutzerdaten)' ;;
 backup_list) helper backup_list "$BACKUP_DIR" ;;
 backup_verify)

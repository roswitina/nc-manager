# nc-manager-cmd – privilegierter Helfer des Nextcloud Server Managers.
# Wird von der Web-App per sudo als root aufgerufen. Nur die Aktionen im
# case-Block am Ende sind erlaubt; alle Argumente werden hier erneut geprüft.
set -u
umask 022
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ENV=/etc/nc-manager.env
LOCK=/run/nc-manager.lock
HELPER=/usr/local/lib/nc-manager/ncm_helper.py
# Overrides nur bei direktem Aufruf (Tests), niemals über sudo.
if [ -z "${SUDO_USER:-}" ]; then
  ENV=${NCM_ENV_FILE:-$ENV}; LOCK=${NCM_LOCK:-$LOCK}; HELPER=${NCM_HELPER:-$HELPER}
fi

[ -r "$ENV" ] || { echo 'Konfiguration fehlt'; exit 90; }
read_env() { sed -n "s/^$1=//p" "$ENV" | head -n1; }
NCM_BACKEND="$(read_env NCM_BACKEND)"
NCM_NCC="$(read_env NCM_NCC)"
NCM_PHP="$(read_env NCM_PHP)"
NCM_NC_PATH="$(read_env NCM_NC_PATH)"
NCM_WEBUSER="$(read_env NCM_WEBUSER)"
BACKUP_DIR="$(read_env NCM_BACKUP_DIR)"; BACKUP_DIR=${BACKUP_DIR:-/var/backups/nc-manager}
BACKUP_KEEP="$(read_env NCM_BACKUP_KEEP)"; [[ "$BACKUP_KEEP" =~ ^[0-9]{1,3}$ ]] || BACKUP_KEEP=3
# Bei der Installation (als root) festgehaltenes Datenverzeichnis – Vertrauensanker für alles, was root
# im Datenverzeichnis tut. config.php allein reicht dafür nicht, sie ist für den Webserver-Benutzer beschreibbar.
NCM_DATADIR="$(read_env NCM_DATADIR)"; NCM_DATADIR=${NCM_DATADIR%/}
helper() { python3 "$HELPER" "$@"; }
[ -n "$NCM_PHP" ] && [ -n "$NCM_NC_PATH" ] && [ -n "$NCM_WEBUSER" ] || {
  echo 'Technische Konfiguration unvollständig'; exit 91
}
ACTION="${1:-}"

# ---------------------------------------------------------------- Hilfsfunktionen

# occ immer nicht-interaktiv: sonst warten z.B. bigint oder upgrade auf eine Eingabe.
runocc() {
  if [ "$NCM_BACKEND" = ncc ] && [ -x "$NCM_NCC" ]; then
    "$NCM_NCC" --no-interaction "$@"
  else
    runuser -u "$NCM_WEBUSER" -- "$NCM_PHP" "$NCM_NC_PATH/occ" --no-interaction "$@"
  fi
}

# versions:expire und trashbin:expire enden mit Exit 1 und „Auto expiration is configured …“, wenn die
# Aufbewahrung auf „auto“ steht (Standard). Das ist kein Fehler: Nextcloud räumt dann selbst über die
# Hintergrundjobs auf. Ausgabe bleibt live sichtbar (tee).
run_expire() {
  local f rc
  tmpfile f
  runocc "$@" 2>&1 | tee "$f"; rc=${PIPESTATUS[0]}
  if [ "$rc" != 0 ] && grep -q 'Auto expiration is configured' "$f"; then
    echo 'HINWEIS: Kein Fehler – die Aufbewahrung steht auf „auto“ (Nextcloud-Standard). Nextcloud löscht'
    echo 'abgelaufene Einträge dann selbst über die Hintergrundjobs; manuell ist nichts zu tun.'
    return 0
  fi
  return "$rc"
}

# Nur eine ändernde Aktion gleichzeitig (Update, Repair, PHP …).
take_lock() {
  exec 9>"$LOCK"
  flock -n 9 || { echo 'Es läuft bereits eine andere Aktion des Managers. Bitte warten.'; exit 75; }
}

# json_out key value [key value …]
#   key:json      value ist JSON-Text (nur für kleine Werte – Argumente sind auf 128 KB begrenzt)
#   key:jsonfile  value ist eine Datei mit JSON-Inhalt (für große Werte wie Logs)
json_out() {
  python3 -c '
import json, sys
a = sys.argv[1:]; o = {}
for k, v in zip(a[::2], a[1::2]):
    if k.endswith(":jsonfile"):
        k = k[:-9]
        try:
            with open(v, encoding="utf-8", errors="replace") as f:
                v = f.read()
        except OSError:
            v = ""
        kind = "json"
    elif k.endswith(":json"):
        k = k[:-5]; kind = "json"
    else:
        kind = "text"
    if kind == "json":
        try:
            v = json.loads(v) if v.strip() else None
        except ValueError:
            v = None
    o[k] = v
print(json.dumps(o, ensure_ascii=False))' "$@"
}

# Temporäre Dateien des Wrappers, werden beim Beenden gelöscht.
TMPFILES=()
# Aufruf ohne Subshell (tmpfile name), sonst geht der Eintrag in TMPFILES verloren.
tmpfile() { local _f; _f=$(mktemp); TMPFILES+=("$_f"); printf -v "$1" '%s' "$_f"; }

# Ausgewählte, unkritische Werte aus config.php (+ *.config.php) – ausgeführt als Web-User.
nc_config() {
  runuser -u "$NCM_WEBUSER" -- "$NCM_PHP" -r '
$d = $argv[1]; $c = [];
foreach (array_merge([$d . "/config.php"], glob($d . "/*.config.php") ?: []) as $f) {
  $CONFIG = []; if (is_readable($f)) { include $f; } $c = array_merge($c, $CONFIG);
}
$o = [];
foreach (["datadirectory", "dbtype", "dbhost", "dbname", "memcache.local", "memcache.distributed", "memcache.locking", "logfile", "log_type", "loglevel", "log_rotate_size", "htaccess.RewriteBase", "overwrite.cli.url"] as $k) { $o[$k] = $c[$k] ?? null; }
echo json_encode($o, JSON_UNESCAPED_SLASHES);' -- "$NCM_NC_PATH/config" 2>/dev/null
}

# DB-Zugangsdaten für den Dump. Nur intern verwenden und direkt per Pipe an den Helfer geben,
# niemals ausgeben oder als Argument übergeben. Das Datenverzeichnis (für SQLite) kommt aus
# /etc/nc-manager.env, nicht aus config.php; der Helfer prüft die übrigen Werte.
nc_db_creds() {
  runuser -u "$NCM_WEBUSER" -- "$NCM_PHP" -r '
$d = $argv[1]; $c = [];
foreach (array_merge([$d . "/config.php"], glob($d . "/*.config.php") ?: []) as $f) {
  $CONFIG = []; if (is_readable($f)) { include $f; } $c = array_merge($c, $CONFIG);
}
$o = [];
foreach (["dbtype", "dbhost", "dbport", "dbname", "dbuser", "dbpassword", "datadirectory"] as $k) { $o[$k] = $c[$k] ?? null; }
if (($argv[2] ?? "") !== "") { $o["datadirectory"] = $argv[2]; }
echo json_encode($o);' -- "$NCM_NC_PATH/config" "$NCM_DATADIR" 2>/dev/null
}

# Redis-Konfiguration inkl. Passwort – nur per Pipe an den Helfer, nie ausgeben.
nc_redis_creds() {
  runuser -u "$NCM_WEBUSER" -- "$NCM_PHP" -r '
$d = $argv[1]; $c = [];
foreach (array_merge([$d . "/config.php"], glob($d . "/*.config.php") ?: []) as $f) {
  $CONFIG = []; if (is_readable($f)) { include $f; } $c = array_merge($c, $CONFIG);
}
echo json_encode(["redis" => $c["redis"] ?? null]);' -- "$NCM_NC_PATH/config" 2>/dev/null
}

nc_logfile() {
  local cfg lf
  cfg=$(nc_config)
  lf=$(printf '%s' "$cfg" | json_get logfile)
  [ -n "$lf" ] || lf="$(printf '%s' "$cfg" | json_get datadirectory)/nextcloud.log"
  printf '%s' "$lf"
}

# Vom Manager eingeschalteter Wartungsmodus wird beim Beenden wieder ausgeschaltet (z.B. nach einem
# abgebrochenen Vollbackup). Beim Restore bleibt er bei Fehlern bewusst an (MAINT_KEEP=1).
MAINT_BY_US=0; MAINT_KEEP=0
maint_on() { runocc maintenance:mode --on >/dev/null && MAINT_BY_US=1; }
maint_off() { if [ "$MAINT_BY_US" = 1 ]; then runocc maintenance:mode --off >/dev/null && MAINT_BY_US=0; fi; }
cleanup() {
  rm -f "${TMPFILES[@]}"
  if [ "$MAINT_BY_US" = 1 ] && [ "$MAINT_KEEP" = 0 ]; then
    runocc maintenance:mode --off >/dev/null 2>&1 && echo 'Wartungsmodus wieder ausgeschaltet.'
  fi
}
trap cleanup EXIT

# Hooks: nur ausführbare, root-eigene Dateien, die für Gruppe/Andere nicht beschreibbar sind
# (sonst könnte jeder mit Schreibrecht Code als root ausführen lassen).
HOOKS_DIR=/etc/nc-manager/hooks
if [ -z "${SUDO_USER:-}" ]; then HOOKS_DIR=${NCM_HOOKS_DIR:-$HOOKS_DIR}; fi
safe_root_path() {
  local p="$1" own perm
  own=$(stat -c %u "$p" 2>/dev/null) || return 1
  perm=$(stat -c %a "$p")
  [ "$own" = 0 ] && (( (8#$perm & 8#022) == 0 ))
}
run_hook() {   # run_hook name [VAR=wert ...]
  local h="$HOOKS_DIR/$1"; shift
  [ -e "$h" ] || return 0
  if [ ! -f "$h" ] || [ ! -x "$h" ] || ! safe_root_path "$h" || ! safe_root_path "$HOOKS_DIR"; then
    echo "FEHLER: Hook $h wird nicht ausgeführt – er muss eine ausführbare Datei von root sein und darf (wie sein Ordner) für Gruppe/Andere nicht beschreibbar sein."
    return 2
  fi
  echo "--- Hook $(basename "$h")"
  env NCM_NC_PATH="$NCM_NC_PATH" NCM_BACKUP_DIR="$BACKUP_DIR" "$@" "$h"
}

# Datenverzeichnis prüfen, bevor root damit arbeitet (tar, mv, chown -R, rm -rf, SQLite-Datei).
# Der Wert stammt aus config.php, die der Webserver-Benutzer ändern kann. Wer Nextcloud kompromittiert,
# könnte dort sonst z. B. /etc eintragen und root würde es beim nächsten Restore www-data übereignen.
# Gibt bei einem Problem den Grund aus und liefert 1.
check_datadir() {
  local d="$1" owner
  [ -n "$d" ] || { echo 'Datenverzeichnis ist in config.php nicht gesetzt.'; return 1; }
  [ -n "$NCM_DATADIR" ] || {
    echo "Das Datenverzeichnis ist in $ENV nicht festgehalten (NCM_DATADIR fehlt). Bitte install.sh erneut ausführen."; return 1; }
  [ "$d" = "$NCM_DATADIR" ] || {
    echo "Datenverzeichnis in config.php ($d) weicht vom bei der Installation festgehaltenen ($NCM_DATADIR) ab." \
         'Falls es absichtlich verschoben wurde: install.sh erneut ausführen, sonst config.php prüfen.'; return 1; }
  case "$d" in /*) ;; *) echo "Datenverzeichnis $d ist kein absoluter Pfad."; return 1;; esac
  case "$d/" in *//*|*/./*|*/../*) echo "Datenverzeichnis $d enthält // . oder .. – abgelehnt."; return 1;; esac
  case "$d" in
    /|/bin|/boot|/dev|/etc|/home|/lib|/lib32|/lib64|/libx32|/media|/mnt|/opt|/proc|/root|/run|/sbin|/srv|/sys|/tmp|/usr|/var|/var/backups|/var/lib|/var/log|/var/www|/var/www/html|\
    /bin/*|/boot/*|/dev/*|/etc/*|/lib/*|/lib32/*|/lib64/*|/libx32/*|/proc/*|/root/*|/run/*|/sbin/*|/sys/*|/usr/*)
      echo "Datenverzeichnis $d ist ein Systemverzeichnis – abgelehnt."; return 1;;
  esac
  [ -d "$d" ] && [ ! -L "$d" ] || { echo "Datenverzeichnis $d fehlt oder ist ein symbolischer Link."; return 1; }
  owner=$(stat -c %U -- "$d" 2>/dev/null)
  [ "$owner" = "$NCM_WEBUSER" ] || { echo "Datenverzeichnis $d gehört $owner, nicht $NCM_WEBUSER."; return 1; }
  [ -e "$d/.ocdata" ] || { echo "In $d fehlt die Nextcloud-Markierung .ocdata – kein Nextcloud-Datenverzeichnis?"; return 1; }
  case "$NCM_NC_PATH/" in "$d"/*) echo "Der Programmordner liegt im Datenverzeichnis $d – abgelehnt."; return 1;; esac
  case "$BACKUP_DIR/" in "$d"/*) echo "Das Backup-Verzeichnis liegt im Datenverzeichnis $d – abgelehnt."; return 1;; esac
  return 0
}

# Setzt DATADIR auf das geprüfte Datenverzeichnis; sonst Meldung und Rückgabe 1.
DATADIR=
load_datadir() {
  local d why
  d=$(nc_config | json_get datadirectory); d=${d%/}
  if ! why=$(check_datadir "$d"); then echo "ABBRUCH: $why"; return 1; fi
  DATADIR=$d
}

# Backup von Datenbank, Programmcode, config.php und optional Benutzerdaten.
#   do_backup <mit_daten 0|1> <grund> <geschützter Name für prune>
# Setzt BACKUP_NAME auf den Namen des neuen Backups.
BACKUP_NAME=
do_backup() {
  local include_data="${1:-0}" reason="${2:-manuell}" protect="${3:-}"
  local ts dir datadir parent base size dsize=0 free dbtype rc
  ts=$(date +%Y%m%d-%H%M%S); dir="$BACKUP_DIR/$ts"
  while [ -e "$dir" ]; do sleep 1; ts=$(date +%Y%m%d-%H%M%S); dir="$BACKUP_DIR/$ts"; done
  load_datadir || return 38
  datadir=$DATADIR
  mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"
  dbtype=$(nc_config | json_get dbtype)
  size=$(du -sk ${datadir:+"--exclude=$datadir"} "$NCM_NC_PATH" | awk '{print $1}')
  if [ "$include_data" = 1 ]; then
    [ -n "$datadir" ] && [ -d "$datadir" ] || { echo "FEHLER: Datenverzeichnis $datadir nicht gefunden."; return 33; }
    dsize=$(du -sk "$datadir" | awk '{print $1}')
  fi
  free=$(df -Pk "$BACKUP_DIR" | awk 'NR==2{print $4}')
  echo "=== Backup nach $dir ($([ "$include_data" = 1 ] && echo 'mit' || echo 'ohne') Benutzerdaten) ==="
  [ "$free" -gt "$((size + dsize + 1048576))" ] || {
    echo "FEHLER: Zu wenig Platz in $BACKUP_DIR (frei: $((free / 1024)) MiB, benötigt: ca. $(( (size + dsize) / 1024 + 1024 )) MiB)."; return 30; }
  mkdir -m 700 "$dir" || return 30
  if [ "$include_data" = 1 ]; then
    # Datenbank und Dateien müssen zum selben Zeitpunkt gehören.
    echo 'Wartungsmodus ein (für ein konsistentes Vollbackup) ...'
    maint_on || { echo 'FEHLER: Wartungsmodus konnte nicht eingeschaltet werden.'; rm -rf "$dir"; return 34; }
  fi
  echo 'Sichere Datenbank ...'
  if ! nc_db_creds | helper db_dump "$dir/database.sql.gz"; then
    echo 'FEHLER: Datenbank-Backup fehlgeschlagen.'; rm -rf "$dir"; maint_off; return 31
  fi
  echo 'Sichere Programmcode (ohne Datenverzeichnis) ...'
  parent=$(dirname "$NCM_NC_PATH"); base=$(basename "$NCM_NC_PATH")
  local excl=()
  case "$datadir/" in "$NCM_NC_PATH"/*) excl=(--anchored "--exclude=$base${datadir#"$NCM_NC_PATH"}");; esac
  if ! tar -C "$parent" "${excl[@]}" -czf "$dir/nextcloud-code.tar.gz" "$base"; then
    echo 'FEHLER: Sichern des Programmcodes fehlgeschlagen.'; rm -rf "$dir"; maint_off; return 32
  fi
  if [ "$include_data" = 1 ]; then
    echo "Sichere Benutzerdaten aus $datadir (kann lange dauern) ..."
    tar -C "$(dirname "$datadir")" --warning=no-file-changed -czf "$dir/nextcloud-data.tar.gz" "$(basename "$datadir")"
    rc=$?
    # tar-Exit-Code 1 = einzelne Dateien haben sich beim Lesen geändert (z.B. nextcloud.log) – kein Abbruch.
    if [ "$rc" -gt 1 ]; then echo 'FEHLER: Sichern der Benutzerdaten fehlgeschlagen.'; rm -rf "$dir"; maint_off; return 33; fi
    [ "$rc" = 1 ] && echo 'HINWEIS: Einzelne Dateien haben sich während des Sicherns geändert.'
    maint_off; echo 'Wartungsmodus aus.'
  fi
  cp -a "$NCM_NC_PATH/config/config.php" "$dir/config.php"
  python3 -c 'import json,sys
a = sys.argv
json.dump({"complete": True, "version": a[1], "nc_path": a[2], "datadir": a[3], "created": a[4], "dbtype": a[6],
           "user_data_included": a[7] == "1", "reason": a[8], "manager_version": "0.7.0"}, open(a[5], "w"))' \
    "$(runocc status --output=json | json_get versionstring)" "$NCM_NC_PATH" "$datadir" "$ts" "$dir/info.json" \
    "$dbtype" "$include_data" "$reason"
  if [ "$include_data" = 1 ]; then local data_line="Benutzerdaten: ENTHALTEN (nextcloud-data.tar.gz, Stand $datadir)"
  else local data_line="Benutzerdaten: NICHT enthalten ($datadir) – dafür ein externes Backup/Snapshot verwenden"; fi
  cat >"$dir/WIEDERHERSTELLEN.txt" <<TXT
Backup vom $ts – Nextcloud $NCM_NC_PATH
Enthalten: Datenbank, Programmcode und config.php.
$data_line

Am einfachsten: In der Oberfläche unter Backups → "Wiederherstellen …" (prüft das Backup vorher,
legt vorher ein Sicherheits-Backup des aktuellen Stands an und benennt Altes nur um).

Von Hand (als root, Nextcloud vorher in den Wartungsmodus setzen):
  1. Datenbank (der Wartungsmodus sperrt solange alle Zugriffe). Vorher ALLE Tabellen löschen bzw.
     die Datenbank neu anlegen, sonst bleiben neuere Tabellen übrig und das nächste Upgrade scheitert:
     MySQL/MariaDB: zcat database.sql.gz | mysql <dbname>
     PostgreSQL:    zcat database.sql.gz | psql -v ON_ERROR_STOP=1 -U <dbuser> -d <dbname>
     SQLite:        zcat database.sqlite.gz > <datadir>/<dbname>.db  (Besitzer: $NCM_WEBUSER)
  2. Benutzerdaten (nur wenn enthalten): mv $datadir $datadir.alt && tar -C $(dirname "${datadir:-/x}") -xzf nextcloud-data.tar.gz
  3. Programmcode: mv $NCM_NC_PATH $NCM_NC_PATH.alt && tar -C $parent -xzf nextcloud-code.tar.gz
  4. chown -R $NCM_WEBUSER:$NCM_WEBUSER $NCM_NC_PATH ${datadir}
  5. occ maintenance:data-fingerprint, Wartungsmodus aus.
     Ohne Benutzerdaten im Backup danach: occ files:scan --all
TXT
  # Prüfsummen zuletzt: über alle Dateien des Backups
  (cd "$dir" && sha256sum -- * > checksums.sha256) || { echo 'FEHLER: Prüfsummen konnten nicht erstellt werden.'; rm -rf "$dir"; return 35; }
  chown -R root:root "$dir"; chmod 600 "$dir"/*
  du -sh "$dir" | awk '{print "Backup fertig: " $2 " (" $1 ")"}'
  BACKUP_NAME=$ts
  helper backup_prune "$BACKUP_DIR" "$BACKUP_KEEP" "$protect"
  run_hook post-backup NCM_BACKUP_PATH="$dir" || echo 'WARNUNG: post-backup-Hook fehlgeschlagen.'
  return 0
}

# Wiederherstellung eines Manager-Backups. Reihenfolge so, dass Nextcloud erst wieder erreichbar ist,
# wenn Datenbank, Daten und Code zusammenpassen; bei Fehlern bleibt der Wartungsmodus an.
do_restore() {
  local name="$1" d="$BACKUP_DIR/$1" bnc bdata with_data datadir parent base ts tmpd old dataold free need dbfile safety
  ts=$(date +%Y%m%d-%H%M%S)
  echo "=== Wiederherstellung von Backup $name ==="
  echo '--- 1/7 Backup vollständig prüfen'
  helper backup_verify "$BACKUP_DIR" "$name" || { echo 'ABBRUCH: Backup-Prüfung fehlgeschlagen – es wurde nichts verändert.'; return 66; }

  echo '--- 2/7 Voraussetzungen prüfen'
  bnc=$(helper backup_info "$BACKUP_DIR" "$name" nc_path); bdata=$(helper backup_info "$BACKUP_DIR" "$name" datadir)
  bdata=${bdata%/}
  with_data=$(helper backup_info "$BACKUP_DIR" "$name" user_data_included)
  load_datadir || { echo 'Es wurde nichts verändert.'; return 67; }
  datadir=$DATADIR
  parent=$(dirname "$NCM_NC_PATH"); base=$(basename "$NCM_NC_PATH")
  [ "${bnc%/}" = "$NCM_NC_PATH" ] || { echo "ABBRUCH: Backup gehört zu $bnc, nicht zu $NCM_NC_PATH."; return 67; }
  [ -z "$bdata" ] || [ "$bdata" = "$datadir" ] || { echo "ABBRUCH: Datenverzeichnis im Backup ($bdata) weicht vom aktuellen ($datadir) ab."; return 67; }
  case "$datadir/" in "$NCM_NC_PATH"/*)
    echo "ABBRUCH: Das Datenverzeichnis liegt im Programmordner ($datadir). Automatischer Restore nicht möglich – bitte von Hand nach WIEDERHERSTELLEN.txt."; return 67;; esac
  local cbytes dbytes
  cbytes=$(helper backup_info "$BACKUP_DIR" "$name" code_bytes); dbytes=$(helper backup_info "$BACKUP_DIR" "$name" data_bytes)
  [[ "$cbytes" =~ ^[0-9]+$ ]] || cbytes=0; [[ "$dbytes" =~ ^[0-9]+$ ]] || dbytes=0
  need=$(( cbytes / 1024 + 524288 ))
  free=$(df -Pk "$parent" | awk 'NR==2{print $4}')
  [ "$free" -gt "$need" ] || { echo "ABBRUCH: Zu wenig Platz in $parent (frei $((free/1024)) MiB, nötig ca. $((need/1024)) MiB)."; return 67; }
  if [ "$with_data" = true ]; then
    if mountpoint -q "$datadir"; then
      echo "ABBRUCH: $datadir ist ein eigener Mountpoint und kann nicht umbenannt werden. Benutzerdaten bitte von Hand zurückspielen (WIEDERHERSTELLEN.txt)."; return 67
    fi
    need=$(( dbytes / 1024 + 1048576 ))
    free=$(df -Pk "$(dirname "$datadir")" | awk 'NR==2{print $4}')
    [ "$free" -gt "$need" ] || { echo "ABBRUCH: Zu wenig Platz für die Benutzerdaten (frei $((free/1024)) MiB, nötig ca. $((need/1024)) MiB)."; return 67; }
  fi
  echo '  ✓ Backup passt zu dieser Installation, genug Speicherplatz'

  echo '--- 3/7 Sicherheits-Backup des aktuellen Stands (Datenbank + Code)'
  do_backup 0 "vor Wiederherstellung von $name" "$name" || { echo 'ABBRUCH: Sicherheits-Backup fehlgeschlagen – es wurde nichts verändert.'; return 68; }
  safety=$BACKUP_NAME
  echo "  Sicherheits-Backup: $safety"

  echo '--- 4/7 Programmcode vorbereiten und Wartungsmodus einschalten'
  tmpd=$(mktemp -d "$parent/.ncm-restore-XXXXXX") || return 70
  chmod 755 "$tmpd"   # occ läuft als Webserver-Benutzer und muss hinein
  if ! tar -C "$tmpd" -xzf "$d/nextcloud-code.tar.gz" || [ ! -f "$tmpd/$base/occ" ]; then
    rm -rf "$tmpd"; echo 'ABBRUCH: Programmcode konnte nicht entpackt werden – nichts verändert.'; return 70
  fi
  cp -a "$d/config.php" "$tmpd/$base/config/config.php"
  chown -R "$NCM_WEBUSER:$NCM_WEBUSER" "$tmpd/$base"
  # Der zurückgespielte Code soll erst nach Abschluss erreichbar werden.
  runuser -u "$NCM_WEBUSER" -- "$NCM_PHP" "$tmpd/$base/occ" --no-interaction maintenance:mode --on >/dev/null 2>&1 \
    || echo '  Hinweis: Wartungsmodus im vorbereiteten Code nicht setzbar – wird nach dem Austausch gesetzt.'
  MAINT_KEEP=1
  maint_on || { rm -rf "$tmpd"; echo 'ABBRUCH: Wartungsmodus nicht einschaltbar.'; return 68; }
  echo '  ✓ Nextcloud ist im Wartungsmodus'

  if [ "$with_data" = true ]; then
    echo '--- 5/7 Benutzerdaten zurückspielen'
    dataold="$datadir.ncm-before-restore-$ts"
    mv "$datadir" "$dataold" || { rm -rf "$tmpd"; echo 'FEHLER: Datenverzeichnis nicht umbenennbar. Nichts verändert, Wartungsmodus bleibt an.'; return 72; }
    if ! tar -C "$(dirname "$datadir")" -xzf "$d/nextcloud-data.tar.gz"; then
      rm -rf "$datadir"; mv "$dataold" "$datadir"; rm -rf "$tmpd"
      echo 'FEHLER: Benutzerdaten nicht entpackbar – alter Stand wiederhergestellt, Wartungsmodus bleibt an.'; return 72
    fi
    chown -R "$NCM_WEBUSER:$NCM_WEBUSER" "$datadir"
    echo "  ✓ Vorherige Benutzerdaten: $dataold"
  else
    echo '--- 5/7 Benutzerdaten: nicht im Backup – bleiben unverändert'
  fi

  echo '--- 6/7 Datenbank zurückspielen'
  dbfile="$d/database.sql.gz"; [ -f "$dbfile" ] || dbfile="$d/database.sqlite.gz"
  if ! nc_db_creds | helper db_restore "$dbfile" "$NCM_WEBUSER"; then
    echo 'FEHLER beim Datenbank-Import. Spiele den Stand von vorher (Sicherheits-Backup) zurück ...'
    local sdb="$BACKUP_DIR/$safety/database.sql.gz"; [ -f "$sdb" ] || sdb="$BACKUP_DIR/$safety/database.sqlite.gz"
    if nc_db_creds | helper db_restore "$sdb" "$NCM_WEBUSER"; then echo '  Datenbank auf den Stand vor dem Restore zurückgesetzt.'
    else echo "  ACHTUNG: Auch das Zurücksetzen schlug fehl. Sicherheits-Backup: $BACKUP_DIR/$safety"; fi
    if [ "$with_data" = true ]; then rm -rf "$datadir"; mv "$dataold" "$datadir" && echo '  Benutzerdaten auf den vorherigen Stand zurückgesetzt.'; fi
    rm -rf "$tmpd"; echo 'Wartungsmodus bleibt an – bitte Ausgabe prüfen.'; return 69
  fi

  echo '--- 7/7 Programmcode austauschen und abschließen'
  old="$NCM_NC_PATH.ncm-before-restore-$ts"
  mv "$NCM_NC_PATH" "$old" || { rm -rf "$tmpd"; echo 'FEHLER: Alter Code nicht umbenennbar. Datenbank ist bereits zurückgespielt – Wartungsmodus bleibt an.'; return 71; }
  mv "$tmpd/$base" "$NCM_NC_PATH" || { mv "$old" "$NCM_NC_PATH"; echo 'FEHLER: Code-Austausch fehlgeschlagen – alter Code zurück, Wartungsmodus bleibt an.'; return 71; }
  rmdir "$tmpd" 2>/dev/null
  runocc maintenance:mode --on >/dev/null 2>&1
  runocc maintenance:data-fingerprint || true
  runocc maintenance:mode --off || { echo 'WARNUNG: Wartungsmodus konnte nicht ausgeschaltet werden.'; return 73; }
  MAINT_BY_US=0
  echo
  echo 'WIEDERHERSTELLUNG ABGESCHLOSSEN.'
  echo "  Vorheriger Code:          $old"
  [ "$with_data" = true ] && echo "  Vorherige Benutzerdaten:  $dataold"
  echo "  Sicherheits-Backup (DB+Code vom Stand davor): $safety"
  [ "$with_data" = true ] || echo '  Benutzerdaten waren nicht im Backup: Bei Abweichungen unter Wartung „Alle Dateien neu einlesen“ ausführen.'
  echo '  Wenn alles läuft, können die .ncm-before-restore-Ordner gelöscht werden.'
  return 0
}

json_get() { python3 -c 'import json,sys
try: v = json.loads(sys.stdin.read() or "{}").get(sys.argv[1])
except ValueError: v = None
print("" if v is None else (str(v).lower() if isinstance(v, bool) else v))' "$1"; }

df_line() { df -Pk "$1" 2>/dev/null | awk 'NR==2{printf "%s|%s|%s|%s",$2,$3,$4,$6}'; }

# Versionen aller laufenden PHP-FPM-Dienste, z.B. "8.2"
fpm_versions() {
  systemctl list-units --type=service --state=running --no-legend 'php*-fpm.service' 2>/dev/null \
    | awk '{print $1}' | sed -n 's/^php\([0-9][0-9.]*\)-fpm\.service$/\1/p'
}
cli_version() { "$NCM_PHP" -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null; }
apache_modphp() {
  systemctl is-active --quiet apache2 2>/dev/null && apache2ctl -M 2>/dev/null | grep -q 'php[0-9]*_module'
}

# conf.d-Verzeichnisse, in die der Manager schreibt.
php_ini_dirs() {
  local cv v
  cv="$(cli_version)"
  [ -d "/etc/php/$cv/cli/conf.d" ] && echo "/etc/php/$cv/cli/conf.d"
  for v in $(fpm_versions); do
    [ -d "/etc/php/$v/fpm/conf.d" ] && echo "/etc/php/$v/fpm/conf.d"
  done
  if apache_modphp && [ -d "/etc/php/$cv/apache2/conf.d" ]; then echo "/etc/php/$cv/apache2/conf.d"; fi
}

# ---------------------------------------------------------------- Webserver
# Die Seite „Webserver“ liest nur; ändern darf der Manager allein Apache-Module aus einer festen Liste
# einschalten und den Webserver nach erfolgreichem Konfigurationstest neu laden.
WEB_MODULES='rewrite headers env dir mime setenvif'
web_active() {
  if [ -d /run/systemd/system ]; then systemctl is-active --quiet "$1"; else pgrep -x "$1" >/dev/null; fi
}
web_test() {
  case "$1" in apache2) apache2ctl configtest 2>&1 ;; nginx) nginx -t 2>&1 ;; *) return 1 ;; esac
}
web_reload_service() {
  if [ -d /run/systemd/system ]; then systemctl reload "$1"
  else case "$1" in apache2) apache2ctl graceful ;; nginx) nginx -s reload ;; esac
  fi
}

php_value_ok() {
  case "$1" in
    memory_limit) [[ $2 =~ ^(-1|[0-9]{1,6}[KMGkmg]?)$ ]] ;;
    upload_max_filesize|post_max_size) [[ $2 =~ ^[0-9]{1,6}[KMGkmg]?$ ]] ;;
    max_execution_time|max_input_time) [[ $2 =~ ^(-1|[0-9]{1,6})$ ]] ;;
    opcache.memory_consumption|opcache.interned_strings_buffer|opcache.max_accelerated_files) [[ $2 =~ ^[0-9]{1,7}$ ]] ;;
    output_buffering) [[ $2 =~ ^[0-9]{1,7}$ ]] ;;
    *) return 1 ;;
  esac
}


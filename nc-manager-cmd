   cli_files=$("$NCM_PHP" -r 'echo php_ini_loaded_file(), "\n", str_replace(",", "\n", (string) php_ini_scanned_files());' | sed 's/^[[:space:]]*//' | grep -v '^$' | tr '\n' '|')

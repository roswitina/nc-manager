   runocc update:check || { echo 'Hinweis: update:check wird von dieser Installation evtl. nicht unterstützt.'; exit 1; } ;;

 preflight)
   echo '=== Nextcloud Update-Vorprüfung ==='
   st=$(runocc status --output=json) || { runocc status; echo 'FEHLER: occ status fehlgeschlagen.'; exit 10; }
   runocc status
   [ -f "$NCM_NC_PATH/updater/updater.phar" ] || { echo 'FEHLER: updater/updater.phar fehlt.'; exit 11; }
   if [ "$(printf '%s' "$st" | json_get maintenance)" = true ]; then
     echo 'HINWEIS: Wartungsmodus ist bereits aktiv.'
   fi
   datadir=$(nc_config | json_get datadirectory); datadir=${datadir%/}
   FREE=$(df -Pk "$NCM_NC_PATH" | awk 'NR==2{print $4}')
   # Liegt das Datenverzeichnis unter dem Programmverzeichnis, zählt es nicht mit:
   # der Updater sichert nur den Programmcode.
   SIZE=$(du -sk ${datadir:+"--exclude=$datadir"} "$NCM_NC_PATH" | awk '{print $1}')
   echo "Freier Speicher: $((FREE / 1024)) MiB; Nextcloud-Programmcode: $((SIZE / 1024)) MiB${datadir:+ (ohne Datenverzeichnis)}"
   [ "$FREE" -gt "$((SIZE * 2))" ] || { echo 'FEHLER: Für das Update wird mindestens die doppelte Größe des Programmcodes als freier Speicher benötigt.'; exit 12; }
   "$NCM_PHP" -v | head -1
   echo "Backend: ${NCM_BACKEND:-occ}"
   latest=$(find "$BACKUP_DIR" -maxdepth 1 -mindepth 1 -type d -name '[0-9]*-[0-9]*' -printf '%f\n' 2>/dev/null | grep -E '^[0-9]{8}-[0-9]{6}$' | sort -r | head -1)
   if [ -n "$latest" ]; then
     echo "Letztes Manager-Backup: $latest ($( [ "$(helper backup_info "$BACKUP_DIR" "$latest" user_data_included)" = true ] && echo 'mit' || echo 'ohne') Benutzerdaten, Prüfung: $(case "$(helper backup_info "$BACKUP_DIR" "$latest" ok)" in true) echo 'in Ordnung';; false) echo 'FEHLERHAFT';; *) echo 'nicht geprüft';; esac))"
   else
     echo 'Letztes Manager-Backup: keines'
   fi
   echo '--- Verfügbare App-Updates'
   timeout 60 runuser -u "$NCM_WEBUSER" -- "$NCM_PHP" "$NCM_NC_PATH/occ" --no-interaction app:update --showonly 2>&1 || echo '(App Store nicht erreichbar)'
   echo 'Vorprüfung erfolgreich. Vor dem Update externes Backup/Snapshot sicherstellen.' ;;

 nextcloud_update)
   take_lock
   WITH_BACKUP=0; WITH_APPS=0
   for flag in "${@:2}"; do
     case "$flag" in backup) WITH_BACKUP=1 ;; apps) WITH_APPS=1 ;; *) echo "Unbekannte Option: $flag"; exit 65 ;; esac
   done
   echo '=== Nextcloud Update ==='
   run_hook pre-update || { echo 'ABBRUCH: pre-update-Hook fehlgeschlagen – Update wird nicht gestartet.'; exit 18; }
   "$0" preflight || exit $?
   if [ "$WITH_BACKUP" = 1 ]; then do_backup 0 'vor Nextcloud-Update' || { echo 'FEHLER: Backup fehlgeschlagen – Update wird nicht gestartet.'; exit 19; }; fi
   if [ "$WITH_BACKUP" = 0 ]; then
     # Ohne vollständiges Backup wenigstens config.php sichern.
     mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"; TS=$(date +%Y%m%d-%H%M%S)
     cp -a "$NCM_NC_PATH/config/config.php" "$BACKUP_DIR/config.php.$TS" || exit 20
     chown root:root "$BACKUP_DIR/config.php.$TS"; chmod 600 "$BACKUP_DIR/config.php.$TS"
     echo "config.php gesichert: $BACKUP_DIR/config.php.$TS"
   fi
   echo 'Starte offiziellen Nextcloud-Updater...'
   # Der Updater führt im nicht-interaktiven Modus "occ upgrade" bereits selbst aus.
   runuser -u "$NCM_WEBUSER" -- "$NCM_PHP" "$NCM_NC_PATH/updater/updater.phar" --no-interaction \
     || { echo 'FEHLER: Updater abgebrochen.'; exit 21; }

     echo 'Datenbank-Upgrade noch ausstehend – führe occ upgrade aus...'
     runocc upgrade || { echo 'FEHLER bei occ upgrade. Wartungsmodus wird nicht automatisch verändert; Ausgabe prüfen.'; exit 22; }
   fi
   runocc maintenance:repair || exit 23
   runocc db:add-missing-indices || exit 24
   runocc db:add-missing-columns || exit 25
   runocc db:add-missing-primary-keys || exit 26
   if [ "$WITH_APPS" = 1 ]; then
     echo 'Aktualisiere Apps...'
     runocc app:update --all || echo 'WARNUNG: Nicht alle Apps konnten aktualisiert werden (Ausgabe prüfen).'
   fi
   echo 'Abschlussstatus:'
   runocc status || exit 27
   if [ "$(runocc status --output=json | json_get maintenance)" = true ]; then
     echo 'HINWEIS: Wartungsmodus ist noch aktiv. Nach Prüfung unter "Wartung" ausschalten.'
   fi

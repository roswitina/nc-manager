   web=""; systemctl is-active --quiet nginx 2>/dev/null && web=/var/log/nginx/error.log
   systemctl is-active --quiet apache2 2>/dev/null && web=/var/log/apache2/error.log
   fv=$(fpm_versions | head -1)

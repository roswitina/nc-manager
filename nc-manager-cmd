   f_nc=; f_fpm=; f_web=; tmpfile f_nc; tmpfile f_fpm; tmpfile f_web
   # Als Webserver-Benutzer: der Pfad stammt aus config.php und darf keine root-Dateien erreichen.
   runuser -u "$NCM_WEBUSER" -- python3 "$HELPER" nclog "$(nc_logfile)" "$N" >"$f_nc"
   [ -n "$fpmlog" ] && helper textlog "$fpmlog" 200 >"$f_fpm"
   [ -n "$web" ] && helper textlog "$web" 200 >"$f_web"
   json_out log_type "${ltype:-file}" loglevel "$(printf '%s' "$cfg" | json_get loglevel)" \
     log_rotate_size "$(printf '%s' "$cfg" | json_get log_rotate_size)" \
     archives "$(find "$BACKUP_DIR/logs" -maxdepth 1 -name 'nextcloud.log.*.gz' 2>/dev/null | wc -l)" \
     nextcloud:jsonfile "$f_nc" fpm:jsonfile "$f_fpm" web:jsonfile "$f_web" ;;

 log_archive)
   # Nextcloud-Log komprimiert archivieren und danach leeren (Datei bleibt mit Besitzer und Rechten erhalten).
   take_lock
   lf=$(nc_logfile)
   ltype=$(nc_config | json_get log_type)
   [ -z "$ltype" ] || [ "$ltype" = file ] || { echo "Nextcloud schreibt nicht in eine Datei (log_type=$ltype) – nichts zu tun."; exit 65; }
   # Lesen und Leeren als Webserver-Benutzer: Was www-data nicht schreiben darf, wird nicht angefasst.
   runuser -u "$NCM_WEBUSER" -- test -f "$lf" -a -w "$lf" || { echo "FEHLER: $lf fehlt oder ist für $NCM_WEBUSER nicht beschreibbar."; exit 36; }
   ARCH="$BACKUP_DIR/logs"; mkdir -p "$ARCH"; chmod 700 "$BACKUP_DIR" "$ARCH"
   TS=$(date +%Y%m%d-%H%M%S); target="$ARCH/nextcloud.log.$TS.gz"
   size=$(runuser -u "$NCM_WEBUSER" -- stat -c %s "$lf")
   free=$(df -Pk "$ARCH" | awk 'NR==2{print $4}')
   [ "$free" -gt $(( size / 1024 / 5 + 102400 )) ] || { echo "FEHLER: Zu wenig Platz in $ARCH."; exit 36; }
   echo "Archiviere $lf ($((size / 1024)) KiB) nach $target ..."
   # Lesen als www-data, Schreiben als root in das nur für root lesbare Archiv.
   if ! runuser -u "$NCM_WEBUSER" -- cat -- "$lf" | gzip -6 > "$target.part"; then
     rm -f "$target.part"; echo 'FEHLER: Archivieren fehlgeschlagen – Log wurde NICHT geleert.'; exit 36
   fi
   gzip -t "$target.part" || { rm -f "$target.part"; echo 'FEHLER: Archiv ist fehlerhaft – Log wurde NICHT geleert.'; exit 36; }
   chmod 600 "$target.part"; mv "$target.part" "$target"
   runuser -u "$NCM_WEBUSER" -- truncate -s 0 -- "$lf" || { echo 'FEHLER: Log konnte nicht geleert werden (Archiv ist vorhanden).'; exit 37; }
   echo "Log geleert. Archiv: $target ($(du -h "$target" | cut -f1))"
   # Höchstens NCM_LOG_ARCHIVE_KEEP Archive behalten (Standard 10).
   keep="$(read_env NCM_LOG_ARCHIVE_KEEP)"; [[ "$keep" =~ ^[0-9]{1,3}$ ]] || keep=10
   find "$ARCH" -maxdepth 1 -name 'nextcloud.log.*.gz' -printf '%f\n' | sort -r | tail -n +$((keep + 1)) | while read -r old; do
     rm -f -- "${ARCH:?}/$old" && echo "Altes Archiv entfernt: $old"
   done ;;

 log_rotate_set)
   take_lock
   V="${2:-}"; [[ "$V" =~ ^[0-9]{1,12}$ ]] || { echo 'Ungültige Größe (Bytes, 0 = keine Rotation)'; exit 65; }
   runocc log:file --rotate-size="$V" && echo "Log-Rotation: $( [ "$V" = 0 ] && echo 'aus' || echo "ab $((V / 1048576)) MiB")" ;;

 log_level_set)
   take_lock
   case "${2:-}" in 0) L=debug;; 1) L=info;; 2) L=warning;; 3) L=error;; 4) L=fatal;; *) echo 'Ungültiges Log-Level (0-4)'; exit 65;; esac
   runocc log:manage --level="$L" && echo "Log-Level: $L" ;;

 fpm_info)
   # shellcheck disable=SC2046
   helper fpm_info $(fpm_versions) ;;
 fpm_set)
   take_lock
   V="${2:-}"; POOL="${3:-}"; shift 3 2>/dev/null || { echo 'Argumente fehlen'; exit 65; }
   fpm_versions | grep -qx "$V" || { echo "PHP-FPM $V läuft nicht"; exit 65; }
   [[ "$POOL" =~ ^[A-Za-z0-9_.-]{1,32}$ ]] || { echo 'Ungültiger Pool-Name'; exit 65; }
   target="/etc/php/$V/fpm/pool.d/zzzz-nextcloud-manager.conf"
   TS=$(date +%Y%m%d-%H%M%S); BK="$BACKUP_DIR/php"; mkdir -p "$BK"; chmod 700 "$BACKUP_DIR" "$BK"
   bk=""; [ -f "$target" ] && { bk="$BK/fpm-$V-pool.$TS"; cp -a "$target" "$bk"; }
   helper fpm_write "$V" "$POOL" "$@" || exit 66
   if ! "php-fpm$V" -t 2>&1; then
     echo "FEHLER: php-fpm$V -t meldet einen Fehler – Änderung wird zurückgerollt."
     if [ -n "$bk" ]; then cp -a "$bk" "$target"; else rm -f "$target"; fi
     exit 68
   fi
   systemctl reload "php$V-fpm" || { echo "FEHLER: Reload von php$V-fpm fehlgeschlagen."; exit 69; }
   echo "Neu geladen: php$V-fpm" ;;

 files_scan)       take_lock; runocc files:scan --all ;;
 files_cleanup)    take_lock; runocc files:cleanup ;;
 trashbin_expire)  take_lock; run_expire trashbin:expire ;;
 versions_expire)  take_lock; run_expire versions:expire ;;
 trashbin_cleanup) take_lock; runocc trashbin:cleanup --all-users ;;
 versions_cleanup) take_lock; runocc versions:cleanup ;;

 php_info)
   echo "PHP: $("$NCM_PHP" -v | head -1)"
   "$NCM_PHP" --ini
   echo
   "$NCM_PHP" -r 'foreach(["memory_limit","upload_max_filesize","post_max_size","max_execution_time","max_input_time","opcache.memory_consumption","opcache.interned_strings_buffer","opcache.max_accelerated_files","output_buffering"] as $k) echo $k."=".ini_get($k).PHP_EOL;'
   echo; echo "Manager-Ziele:"; php_ini_dirs ;;

 php_set)
   take_lock
   KEY="${2:-}"; VAL="${3:-}"
   php_value_ok "$KEY" "$VAL" || { echo "PHP-Einstellung oder Wert nicht erlaubt: $KEY=$VAL"; exit 65; }
   TS=$(date +%Y%m%d-%H%M%S); BK="$BACKUP_DIR/php"; mkdir -p "$BK"; chmod 700 "$BACKUP_DIR" "$BK"
   targets=(); backups=()
   restore() {
     local i
     for i in "${!targets[@]}"; do
       if [ -n "${backups[$i]}" ]; then cp -a "${backups[$i]}" "${targets[$i]}"; else rm -f "${targets[$i]}"; fi
     done
     echo 'Änderungen zurückgerollt.'
   }
   key_re="^[[:space:]]*${KEY//./\\.}[[:space:]]*="
   while IFS= read -r dir; do
     target="$dir/99-nextcloud-manager.ini"; bk=""
     if [ -f "$target" ]; then bk="$BK/$(printf '%s' "$dir" | tr '/' '_' | sed 's/^_//').$TS"; cp -a "$target" "$bk"; fi
     targets+=("$target"); backups+=("$bk")
     tmp=$(mktemp)
     { [ -f "$target" ] && grep -v -E "$key_re" "$target"; printf '%s=%s\n' "$KEY" "$VAL"; } >"$tmp"
     install -m 0644 "$tmp" "$target"; rm -f "$tmp"
     echo "Gesetzt: $target -> $KEY=$VAL"
   done < <(php_ini_dirs)
   [ "${#targets[@]}" -gt 0 ] || { echo "Keine PHP-conf.d-Verzeichnisse gefunden"; exit 67; }

   # Prüfen, bevor irgendein Dienst neu geladen wird.
   for v in $(fpm_versions); do
     if command -v "php-fpm$v" >/dev/null 2>&1 && ! "php-fpm$v" -t 2>&1; then
       echo "FEHLER: php-fpm$v -t meldet einen Konfigurationsfehler."; restore; exit 68
     fi
   done
   if apache_modphp && ! apache2ctl configtest; then echo 'FEHLER: apache2ctl configtest fehlgeschlagen.'; restore; exit 68; fi
   # max_execution_time ist in der CLI fest 0 – dort ist kein Vergleich möglich.
   eff=$("$NCM_PHP" -r 'echo ini_get($argv[1]);' -- "$KEY")
   [ "$KEY" = max_execution_time ] || [ "$eff" = "$VAL" ] || echo "WARNUNG: CLI meldet $KEY=$eff – eine später geladene Datei überschreibt den Wert."

   # Jede FPM-Version neu laden, in die geschrieben wurde (nicht nur die CLI-Version).
   for v in $(fpm_versions); do
     [ -f "/etc/php/$v/fpm/conf.d/99-nextcloud-manager.ini" ] || continue
     systemctl reload "php$v-fpm" || { echo "FEHLER: Reload von php$v-fpm fehlgeschlagen."; exit 69; }
     echo "Neu geladen: php$v-fpm"
   done
   if apache_modphp; then systemctl reload apache2 || exit 69; echo 'Neu geladen: apache2'; fi
   echo 'Fertig.' ;;

 web_info)
   f_web=; tmpfile f_web; helper web_info "$NCM_NC_PATH" >"$f_web"
   json_out web:jsonfile "$f_web" nc:json "$(nc_config)" nc_path "$NCM_NC_PATH" ;;

 web_enmod)
   take_lock
   MOD="${2:-}"
   case " $WEB_MODULES " in *" $MOD "*) [ -n "$MOD" ] ;; *) false ;; esac || { echo "Modul nicht erlaubt: $MOD (erlaubt: $WEB_MODULES)"; exit 65; }
   web_active apache2 && command -v a2enmod >/dev/null || { echo 'Apache läuft nicht oder a2enmod fehlt.'; exit 67; }
   if [ -e "/etc/apache2/mods-enabled/$MOD.load" ]; then echo "Modul $MOD ist bereits eingeschaltet."; exit 0; fi
   echo "=== Apache-Modul $MOD einschalten ==="
   a2enmod -q "$MOD" || { echo "FEHLER: a2enmod $MOD fehlgeschlagen."; exit 66; }
   if ! web_test apache2; then
     echo 'FEHLER: apache2ctl configtest meldet einen Fehler – Änderung wird zurückgenommen.'
     a2dismod -q -f "$MOD"; exit 68
   fi
   web_reload_service apache2 || { echo 'FEHLER: Apache konnte nicht neu geladen werden.'; exit 69; }
   echo "Modul $MOD eingeschaltet, Apache neu geladen." ;;

 web_reload)
   take_lock
   SRV="${2:-}"
   case "$SRV" in apache2|nginx) ;; *) echo 'Ungültiger Webserver (apache2 oder nginx)'; exit 65 ;; esac
   web_active "$SRV" || { echo "$SRV läuft nicht."; exit 67; }
   echo "=== Konfigurationstest $SRV ==="
   web_test "$SRV" || { echo 'FEHLER: Konfigurationstest fehlgeschlagen – der Webserver wurde NICHT neu geladen.'; exit 68; }
   web_reload_service "$SRV" || { echo "FEHLER: $SRV konnte nicht neu geladen werden."; exit 69; }
   echo "$SRV neu geladen." ;;

 *) echo 'Nicht erlaubte Aktion.'; exit 64 ;;
esac
